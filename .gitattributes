# Enforce LF normalization on Windows
*.yaml eol=lf
*.lua eol=lf
*.cs eol=lf
*.csproj eol=lf
*.sln eol=lf
* text=lf

# Structured reference payloads are byte-hashed by their selection manifest.
docs/reference/peer_corpus/*.jsonl -text
docs/balance/checkpoints/20260911/claude-continuation/inputs.zip -text
docs/balance/checkpoints/20260911/claude-continuation/*.json.gz -text

# Frozen snapshot hashes were captured from CRLF bytes. Preserve those checkout
# bytes on every platform without changing their existing normalized Git blobs.
docs/reference/cameo_baselines/pre_reference_20260910.json text eol=crlf
docs/reference/cameo_baselines/pre_reference_heroes_20260910.json text eol=crlf

# Custom for Visual Studio
*.cs     diff=csharp
