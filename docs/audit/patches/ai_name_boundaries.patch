+"""Tests for reference_distribution.is_ai_only (AI-only name/id detector)."""
+import pathlib
+import sys
+import unittest
+
+ROOT = pathlib.Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT / "tools/balance"))
+
+import reference_distribution as rd
+
+
+def _check(iid, name, source="synthetic"):
+    """Build a row dict and run it through rd.is_ai_only."""
+    return rd.is_ai_only({"id": iid, "name": name, "source": source})
+
+
+class TestIsAiOnly(unittest.TestCase):
+    def test_name_ai_only_upper_space(self):
+        self.assertTrue(_check("SYN1", "AI ONLY"))
+
+    def test_name_ai_only_upper_hyphen(self):
+        self.assertTrue(_check("SYN2", "AI-ONLY"))
+
+    def test_name_for_ai(self):
+        self.assertTrue(_check("SYN3", "for AI"))
+
+    def test_name_parenthesized_ai(self):
+        self.assertTrue(_check("SYN4", "(AI)"))
+
+    def test_id_underscore_ai_suffix(self):
+        self.assertTrue(_check("GUN1_AI", "Synthetic Gunner"))
+
+    def test_id_orcai_is_not_ai_only(self):
+        self.assertFalse(_check("ORCAI", "Orca Interceptor"))
+
+    def test_id_zrai_is_not_ai_only(self):
+        self.assertFalse(_check("ZRAI", "Zone Raider"))
+
+    def test_pattern_has_no_literal_backspace(self):
+        self.assertNotIn(chr(8), rd._AI_NAME.pattern)
+
+
+if __name__ == "__main__":
+    unittest.main()
