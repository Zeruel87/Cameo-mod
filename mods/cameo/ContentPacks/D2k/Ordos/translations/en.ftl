# d2k Ordos pack strings (faction descriptions live in mods/cameo/fluent/rules/en.ftl).

actor_ordos_lightinfantry =
   .name = Ordos Light Infantry
   .description = Fast scout infantry armed with a light machine gun.
      Can be upgraded with Laser Cartridges to fire supplementary laser bolts.
      Benefits from Biological Warfare and Contraband upgrades.
      Strong vs Infantry
      Weak vs Vehicles, Aircraft

actor_ordos_rockettrooper =
   .name = Ordos Rocket Trooper
   .description = Anti-tank/anti-air infantry armed with a rocket launcher.
      Benefits from Biological Warfare and Contraband upgrades.
      Strong vs Vehicles, Aircraft
      Weak vs Infantry

upgrade_ordos_aatrooper =
   .description = Upgrades Ordos Rocket Troopers to Anti Air Troopers.

upgrade_ordos_rapidfirearmorpiercingbelts =
   .description = Autoguns gain +10% firepower, +10% rate of fire, and +5% range.

template_harvester =
   .description = Collects spice for credits.
      Unarmed
